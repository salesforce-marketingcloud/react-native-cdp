{
  "name": "@salesforce-data-cloud/react-native-cdp",
  "version": "1.0.0",
  "description": "Salesforce Data Cloud sdk for React Native",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "react-native": "./src/index.ts",
  "types": "./lib/typescript/module/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "del-cli lib && bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest src",
    "compatibility:android": "node scripts/compatibility/check.js --platform android",
    "compatibility:ios": "node scripts/compatibility/check.js --platform ios",
    "android:test": "./example/android/gradlew -p example/android :salesforce-data-cloud_react-native-cdp:testDebugUnitTest",
    "android:build": "./example/android/gradlew -p example/android :app:assembleRelease",
    "ios:test": "./ios/tests/run_native_tests.sh",
    "clean": "del-cli lib coverage build/generated",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salesforce-marketingcloud/react-native-cdp.git"
  },
  "homepage": "https://github.com/salesforce-marketingcloud/react-native-cdp#readme",
  "bugs": {
    "url": "https://github.com/salesforce-marketingcloud/react-native-cdp/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "react-native",
    "salesforce",
    "marketing-cloud",
    "cdp",
    "customer-data-platform",
    "consent",
    "privacy"
  ],
  "author": "Salesforce Marketing Cloud",
  "license": "Apache-2.0",
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-native": ">=0.76 <0.86"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.85.1",
    "@react-native/jest-preset": "0.85.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.25",
    "@types/react": "19.2.3",
    "del-cli": "^6.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.7.4",
    "react": "19.2.3",
    "react-native": "0.85.1",
    "react-native-builder-bob": "^0.40.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "lib/**/package.json",
    "src/**/*.ts",
    "!src/**/__tests__/**",
    "android/build.gradle",
    "android/src/main/AndroidManifest.xml",
    "android/src/main/java/**/*.kt",
    "android/src/main/java/**/*.java",
    "ios/DataCloudConsentModule.mm",
    "ios/DataCloudConsentModule.swift",
    "ios/DataCloudConsentModuleBridge.m",
    "SdkDataCloudReactnativePlugin.podspec",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      ["commonjs", { "esm": true }],
      ["module", { "esm": true }],
      ["typescript", { "project": "tsconfig.build.json" }]
    ]
  },
  "codegenConfig": {
    "name": "RNDataCloudConsentSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.salesforce.marketingcloud.cdp.reactnative"
    }
  },
  "sideEffects": false
}
